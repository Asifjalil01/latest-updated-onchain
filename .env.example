# Server binding and port
HOST="127.0.0.1"
PORT="3000"

# Auto-generated on first start if missing
BOT_API_TOKEN=""

# Optional Solana RPC primary endpoint (pool always includes 3+ public endpoints)
SOLANA_RPC_URL=""
SOLANA_RPC_URL_BACKUP_1=""
SOLANA_RPC_URL_BACKUP_2=""

# Optional server-side private key (Base58 or JSON byte array)
# Prefer encrypted keystore file unlocked via passphrase in the Wallets view
SOLANA_PRIVATE_KEY=""

# Optional Jupiter API key (if using paid tier)
JUPITER_API_KEY=""

# SQLite database path (WAL mode)
DB_PATH="./data/solana_spot_bot.db"

# Encrypted signer keystore path
KEYSTORE_PATH="./data/signer.enc.json"

# App URL
APP_URL="http://127.0.0.1:3000"
